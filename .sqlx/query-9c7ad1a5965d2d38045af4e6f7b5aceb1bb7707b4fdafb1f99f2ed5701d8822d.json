  "query": "SELECT id, actor_id, action, subject,\n                  detail AS \"detail: serde_json::Value\",\n                  created_at AS \"created_at: DateTime<Utc>\"\n           FROM audit_log\n           WHERE ($1::uuid IS NULL OR id < $1)\n           ORDER BY id DESC\n           LIMIT $2",
