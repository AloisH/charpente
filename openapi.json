{
  "openapi": "3.1.0",
  "info": {
    "title": "charpente API",
    "description": "Backend API. Errors are RFC 9457 problem+json with a stable `code`.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/account": {
      "delete": {
        "tags": [
          "account"
        ],
        "summary": "Erase the account (GDPR art. 17). Deletes the user row; uploads cascade.",
        "operationId": "delete_account",
        "responses": {
          "204": {
            "description": "Account erased"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/v1/account/export": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Export the account's data as JSON (GDPR art. 20).",
        "operationId": "export_account",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountExport"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/v1/admin/audit-log": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "The audit trail of role-guarded actions, newest first.",
        "operationId": "list_audit_log",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 25).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_AuditLogEntryDto"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission"
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List all users (admin only), newest first, cursor-paginated.",
        "operationId": "list_users",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 25).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/api/v1/admin/users/{id}/impersonate": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Log this session in as another user, remembering the admin for the return\ntrip (`POST /auth/stop-impersonation`). Audited in `audit_log`.",
        "operationId": "impersonate_user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User to impersonate",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session now belongs to the target user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No such user"
          },
          "409": {
            "description": "Already impersonating, or targeting yourself"
          }
        }
      }
    },
    "/api/v1/admin/users/{id}/role": {
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Change a user's role (admin only). Recorded in the audit log.",
        "operationId": "set_user_role",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No such user"
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Request a password-reset email.",
        "description": "Always answers 204 — whether the account exists is never revealed, and the\nlookup + send happen off-request so response timing can't reveal it either.",
        "operationId": "forgot_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "If the account exists, a reset email was sent"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in with email + password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The currently authenticated user.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create an account and open a session.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created and logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Send a fresh verification email to the logged-in user.",
        "operationId": "resend_verification",
        "responses": {
          "204": {
            "description": "Verification email sent"
          },
          "401": {
            "description": "Not authenticated"
          },
          "409": {
            "description": "Email already verified"
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Set a new password with a token from the reset email.",
        "description": "Existing sessions die with the old password (the session auth hash is the\npassword hash), and receiving the email proves ownership, so an unverified\nemail becomes verified.",
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "404": {
            "description": "Token unknown, expired, or already used"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/api/v1/auth/stop-impersonation": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Return an impersonating session to the real admin. Audited.",
        "operationId": "stop_impersonation",
        "responses": {
          "200": {
            "description": "Back to the admin account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "This session is not impersonating anyone"
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Confirm an email address with a token from the verification email.\nWorks without a session — the link may be opened in any browser.",
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Email verified"
          },
          "404": {
            "description": "Token unknown, expired, or already used"
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Ingest one client-side wide event (fire-and-forget; rate-limited).",
        "operationId": "ingest_event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/v1/uploads": {
      "get": {
        "tags": [
          "uploads"
        ],
        "summary": "The caller's uploads, newest first, cursor-paginated.",
        "operationId": "list_uploads",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 25).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_UploadDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Declare an upload: validates type + size, records a pending row, returns a\npresigned PUT URL.",
        "operationId": "create_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUploadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/api/v1/uploads/{id}/complete": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Confirm the browser finished its PUT; verifies the object actually exists.",
        "operationId": "complete_upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Upload id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDto"
                }
              }
            }
          },
          "404": {
            "description": "No such pending upload"
          },
          "409": {
            "description": "Object not found in storage"
          }
        }
      }
    },
    "/api/v1/uploads/{id}/download": {
      "get": {
        "tags": [
          "uploads"
        ],
        "summary": "A short-lived download URL for a completed upload.",
        "operationId": "download_upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Upload id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadUploadResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such completed upload"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountExport": {
        "type": "object",
        "required": [
          "user",
          "uploads"
        ],
        "properties": {
          "uploads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadDto"
            }
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "AuditLogEntryDto": {
        "type": "object",
        "required": [
          "id",
          "action",
          "detail",
          "created_at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {},
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ClientEvent": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "fields": {
            "description": "Arbitrary structured context."
          },
          "name": {
            "type": "string",
            "description": "Event name, e.g. \"mutation_failed\"."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request id returned by the failing API call, if any."
          }
        }
      },
      "CreateUploadRequest": {
        "type": "object",
        "required": [
          "filename",
          "content_type",
          "size_bytes"
        ],
        "properties": {
          "content_type": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "CreateUploadResponse": {
        "type": "object",
        "required": [
          "upload",
          "put_url"
        ],
        "properties": {
          "put_url": {
            "type": "string",
            "description": "Presigned URL: PUT the file bytes here with the declared content type."
          },
          "upload": {
            "$ref": "#/components/schemas/UploadDto"
          }
        }
      },
      "DownloadUploadResponse": {
        "type": "object",
        "required": [
          "get_url"
        ],
        "properties": {
          "get_url": {
            "type": "string",
            "description": "Presigned URL, valid for a few minutes."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable machine-readable error codes. Additions are fine; renames are a\nbreaking API change surfaced by the OpenAPI diff.",
        "enum": [
          "validation_failed",
          "invalid_credentials",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "rate_limited",
          "internal"
        ]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Page_AuditLogEntryDto": {
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "action",
                "detail",
                "created_at"
              ],
              "properties": {
                "action": {
                  "type": "string"
                },
                "actor_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "detail": {},
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "subject": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Pass as `cursor` to fetch the next page; absent on the last page."
          }
        }
      },
      "Page_UploadDto": {
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "filename",
                "content_type",
                "size_bytes",
                "state",
                "created_at"
              ],
              "properties": {
                "content_type": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "filename": {
                  "type": "string"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "size_bytes": {
                  "type": "integer",
                  "format": "int64"
                },
                "state": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Pass as `cursor` to fetch the next page; absent on the last page."
          }
        }
      },
      "Page_UserDto": {
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "email",
                "display_name",
                "role",
                "email_verified",
                "impersonating",
                "created_at"
              ],
              "properties": {
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "display_name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "email_verified": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "impersonating": {
                  "type": "boolean",
                  "description": "True when this session is an admin impersonating the user. Only\nmeaningful on session-scoped responses (`/me`, impersonation) — always\nfalse in admin listings."
                },
                "role": {
                  "$ref": "#/components/schemas/RoleDto"
                }
              }
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Pass as `cursor` to fetch the next page; absent on the last page."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details, extended with `code` and field-level `errors`.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": [
              "object",
              "null"
            ],
            "description": "Field-level validation messages, keyed by field name.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Always \"about:blank\"; the machine-readable discriminant is `code`."
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          },
          "token": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RoleDto": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      },
      "SetRoleRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/RoleDto"
          }
        }
      },
      "UploadDto": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "content_type",
          "size_bytes",
          "state",
          "created_at"
        ],
        "properties": {
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "state": {
            "$ref": "#/components/schemas/UploadState"
          }
        }
      },
      "UploadState": {
        "type": "string",
        "enum": [
          "pending",
          "complete"
        ]
      },
      "UserDto": {
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "email_verified",
          "impersonating",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "impersonating": {
            "type": "boolean",
            "description": "True when this session is an admin impersonating the user. Only\nmeaningful on session-scoped responses (`/me`, impersonation) — always\nfalse in admin listings."
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
