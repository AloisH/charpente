{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "unplugin-vue-router/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/typed-router.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "../../packages/api-client/src/**/*.ts"
  ]
}
