# Copy to .env for local development. Every variable here is validated at boot;
# a missing required variable stops the API with an explicit error.

# ── API ──────────────────────────────────────────────────────────
APP_ENV=dev                       # dev | prod
APP_HOST=127.0.0.1
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:5173

DATABASE_URL=postgres://charpente:charpente@localhost:5432/charpente

# Cookie session signing key (64+ random bytes, base64). Generate: openssl rand -base64 64
SESSION_KEY=changeme-generate-with-openssl-rand-base64-64

# ── Storage (S3-compatible; RustFS in dev) ───────────────────────
S3_ENDPOINT=http://localhost:9000
# Only when browsers reach storage on a different host than the API does
# (e.g. API inside compose: S3_ENDPOINT=http://rustfs:9000,
#  S3_PUBLIC_ENDPOINT=https://storage.example.com). Defaults to S3_ENDPOINT.
#S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=charpente
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# ── Seed admin (used by `just seed`) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-admin-password
